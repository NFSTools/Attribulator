<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <Authors>heyitsleo/NFSTools</Authors>
        <Company>NFSTools</Company>
        <Description>Plugin providing profiles for the Speed engine games</Description>
        <Product>Attribulator - Speed Profiles</Product>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <TargetFramework>net7.0</TargetFramework>
        <Version>3.0.0-dev</Version>
        <Configurations>Debug;Release</Configurations>
        <Platforms>AnyCPU</Platforms>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="VaultLib.Core" Version="3.0.0-dev"/>
        <PackageReference Include="VaultLib.Support.Carbon" Version="3.0.0-dev"/>
        <PackageReference Include="VaultLib.Support.MostWanted" Version="3.0.0-dev"/>
        <PackageReference Include="VaultLib.Support.ProStreet" Version="3.0.0-dev"/>
        <PackageReference Include="VaultLib.Support.Undercover" Version="3.0.0-dev"/>
        <PackageReference Include="VaultLib.Support.World" Version="3.0.0-dev"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\hashes.txt">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
        <None Remove="Resources\hashes_bin.txt" />
        <EmbeddedResource Include="Resources\hashes_bin.txt">
          <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Attribulator.API\Attribulator.API.csproj"/>
    </ItemGroup>

</Project>
